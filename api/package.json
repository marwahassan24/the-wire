{
  "name": "@the-wire/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "dotenv -e ../.env -- node-pg-migrate up",
    "migrate:down": "dotenv -e ../.env -- node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "tsx src/seed.ts",
    "sync:moneyinfo": "tsx src/sync/runMoneyInfoSync.ts",
    "test": "NODE_ENV=test tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "argon2": "^0.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.4",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
