# Postgres — used by both docker-compose.yml and the API.
# Copy this file to .env and adjust if needed. .env is gitignored.
POSTGRES_USER=wire
POSTGRES_PASSWORD=wire_dev_password
POSTGRES_DB=the_wire
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wire:wire_dev_password@localhost:5432/the_wire

# API server
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Only read by `npm run seed`. Leave unset locally - it falls back to the
# dev default (changeme123, see seed.ts). Required (no fallback) whenever
# NODE_ENV=production; on Render this is set as a secret env var on the
# api service, never committed here.
# SEED_PASSWORD=
